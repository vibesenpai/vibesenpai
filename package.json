{
  "name": "agentsensei",
  "version": "0.1.0",
  "description": "See what your coding agent's mistakes cost you \u2014 in tokens, with the exact turns, using the AI you already pay for.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agentsensei": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "commands",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "node --experimental-strip-types src/cli.ts",
    "verify:corpus": "bash scripts/verify-corpus.sh",
    "measure": "node --experimental-strip-types scripts/measure-dimensions.ts",
    "pull:swechat": "node --experimental-strip-types scripts/pull-swechat.ts",
    "gold": "node --experimental-strip-types scripts/gold-score.ts",
    "judge:control": "node --experimental-strip-types scripts/judge-control.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/node": "24.10.1",
    "hyparquet": "^1.31.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crozzfire/agentsensei.git"
  },
  "bugs": {
    "url": "https://github.com/crozzfire/agentsensei/issues"
  },
  "homepage": "https://github.com/crozzfire/agentsensei#readme",
  "keywords": [
    "claude-code",
    "ai-agent",
    "coding-agent",
    "observability",
    "local-first",
    "transcript-analysis",
    "developer-tools",
    "agent-evaluation"
  ],
  "private": true
}
