{
  "name": "vibesenpai",
  "version": "0.0.3-alpha",
  "description": "Discover how your agents failed you. vibesenpai reads the sessions already on your disk and shows you where they went wrong: the exact turns, in your own words, and a fix you can apply.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pane": "VIBESENPAI_DISABLE=1 claude plugin test .",
    "typecheck": "tsc --noEmit",
    "lint": "knip",
    "cli": "node --experimental-strip-types src/cli.ts",
    "verify:corpus": "bash scripts/verify-corpus.sh",
    "measure": "node --experimental-strip-types scripts/measure-dimensions.ts",
    "pull:swechat": "node --experimental-strip-types scripts/pull-swechat.ts",
    "gold": "node --experimental-strip-types scripts/gold-score.ts",
    "judge:control": "node --experimental-strip-types scripts/judge-control.ts",
    "validate:release": "bash scripts/validate-release.sh"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/node": "24.10.1",
    "hyparquet": "^1.31.5",
    "knip": "6.43.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibesenpai/vibesenpai.git"
  },
  "bugs": {
    "url": "https://github.com/vibesenpai/vibesenpai/issues"
  },
  "homepage": "https://github.com/vibesenpai/vibesenpai#readme",
  "keywords": [
    "claude-code",
    "ai-agent",
    "coding-agent",
    "observability",
    "local-first",
    "transcript-analysis",
    "developer-tools",
    "agent-evaluation"
  ],
  "private": true
}
