{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_NO_WARNINGS=1 node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-session-start.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_NO_WARNINGS=1 node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-stop.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./pane.tsx"
  ]
}
