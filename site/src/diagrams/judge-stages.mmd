flowchart TD
  P["session packet<br/><small>merged, truncated, redacted</small>"]

  G1{"redact(p) == p ?"}
  P --> G1
  G1 -- no --> ABORT["abort the send"]
  G1 -- yes --> A

  A["stage A — extract<br/><small>never shown the categories</small>"]
  A --> REC["records<br/><small>quote · context · turns</small>"]

  REC --> G2{"redact again ?"}
  G2 -- no --> ABORT
  G2 -- yes --> B

  B["stage B — label<br/><small>reads records, never the transcript</small>"]
  B --> OUT["5 dimensions<br/><small>reasoning before the label</small>"]

  OUT --> ANCHOR{"quote found<br/>in the packet ?"}
  ANCHOR -- no --> DROP["discarded"]
  ANCHOR -- yes --> KEEP["finding"]

  classDef bad color:#9b2c2c
  class ABORT,DROP bad
